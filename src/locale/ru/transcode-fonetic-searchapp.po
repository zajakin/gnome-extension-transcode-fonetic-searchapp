msgid "Transliteration Settings"
msgstr "Настройки транслитерации"

msgid "Transliteration Methods"
msgstr "Методы транслитерации"

msgid "Enable or disable different transliteration methods"
msgstr "Включить или отключить различные методы транслитерации"

msgid "Cyrillic to Latin"
msgstr "Кириллица в латиницу"

msgid "Search 'Учеу' to find 'Extensions'"
msgstr "Введите 'Учеу', чтобы найти 'Extensions'"

msgid "Latin to Cyrillic"
msgstr "Латиница в кириллицу"

msgid "Search 'Hfcib' to find 'Расширения'"
msgstr "Введите 'Hfcib', чтобы найти 'Расширения'"

msgid "Phonetic Layout"
msgstr "Фонетическая раскладка"

msgid "Support phonetic: 'Ras[i' to find 'Расширения' and 'Еьтен' to find 'Extensions'"
msgstr "Поддержка фонетической раскладки: 'Ras[i' для поиска 'Расширения' и 'Еьтен' для поиска 'Extensions'"

msgid "Enable Cyrillic to Latin transliteration"
msgstr "Включить транслитерацию кириллицы в латиницу"

msgid "Transliterate Cyrillic characters to Latin alphabet"
msgstr "Транслитерировать кириллические символы в латинский алфавит"

msgid "Enable Latin to Cyrillic transliteration"
msgstr "Включить транслитерацию латиницы в кириллицу"

msgid "Transliterate Latin characters to Cyrillic alphabet"
msgstr "Транслитерировать латинские символы в кириллический алфавит"

msgid "Enable phonetic layout transliteration"
msgstr "Включить транслитерацию фонетической раскладки"

msgid "Support phonetic keyboard layout transliteration"
msgstr "Поддержка транслитерации фонетической раскладки клавиатуры"
